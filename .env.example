# NeuroBeat Environment Variables
# Copy this file to .env and configure values

# Required: Flask Session Secret Key
SESSION_SECRET=neurobeat-dev-secret-key-change-in-production

# Required: JWT Secret Key
JWT_SECRET_KEY=neurobeat-jwt-dev-secret-key-change-in-production

# Optional / Required for AI Beat Generation & AI Clinical Summaries:
# Hugging Face API Token (create one at https://huggingface.co/settings/tokens)
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here
